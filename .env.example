# Copy to .env (or set in Cloud Run). Never commit real values.

PORT=8080

# Hard ceiling for what the AI seller may ever concede (percent of list price).
MAX_DISCOUNT_PCT=10

# Shopify Admin API (custom app on the store; needs read_products + write_discounts)
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_API_VERSION=2026-07

# Optional: lets Claude phrase the seller's replies. Numbers stay server-clamped.
# Without a key a deterministic Norwegian template voice is used.
ANTHROPIC_API_KEY=
SELLER_MODEL=claude-haiku-4-5-20251001

# CORS allowlist, comma-separated. Empty = any *.myshopify.com origin,
# plus localhost/127.0.0.1 so the standalone demo.html works out of the box.
ALLOWED_ORIGINS=

# Set to 1 to run without Shopify credentials (fixture catalog, fake codes).
MOCK_PRODUCTS=0
